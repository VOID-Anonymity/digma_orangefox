DEVICE_PATH := device/digma/citi609

# Architecture (arm64)
TARGET_ARCH := arm64
TARGET_ARCH_VARIANT := armv8-a
TARGET_CPU_ABI := arm64-v8a
TARGET_CPU_ABI2 :=
TARGET_CPU_VARIANT := generic
TARGET_2ND_ARCH := arm
TARGET_2ND_ARCH_VARIANT := armv7-a-neon
TARGET_2ND_CPU_ABI := armeabi-v7a
TARGET_2ND_CPU_ABI2 := armeabi
TARGET_2ND_CPU_VARIANT := generic

# Platform
TARGET_BOARD_PLATFORM := mt6739
TARGET_BOOTLOADER_BOARD_NAME := citi609

# Kernel & Boot Image
BOARD_KERNEL_CMDLINE := bootopt=64S3,32N2,64N2 buildvariant=user veritykeyid=id:7e4333f9bba00adfe0ede979e28ed1920492b40f -
BOARD_KERNEL_BASE := 0x40078000
BOARD_KERNEL_PAGESIZE := 2048
BOARD_KERNEL_OFFSET := 0x8000
BOARD_RAMDISK_OFFSET := 0x4f88000
BOARD_SECOND_OFFSET := 0xe88000
BOARD_TAGS_OFFSET := 0x3f88000
BOARD_FLASH_BLOCK_SIZE := 131072
BOARD_BOOTIMG_HEADER_VERSION := 1
# TARGET_PREBUILT_KERNEL := $(DEVICE_PATH)/prebuilt/kernel
BOARD_KERNEL_IMAGE_NAME := kernel

BOARD_MKBOOTIMG_ARGS += --ramdisk_offset $(BOARD_RAMDISK_OFFSET) --tags_offset $(BOARD_TAGS_OFFSET) --header_version $(BOARD_BOOTIMG_HEADER_VERSION)

# Partitions
BOARD_RECOVERYIMAGE_PARTITION_SIZE := 13968288
TARGET_USERIMAGES_USE_EXT4 := true
TARGET_USERIMAGES_USE_F2FS := true

# Recovery / OrangeFox
BOARD_HAS_NO_SELECT_BUTTON := true
TARGET_RECOVERY_FSTAB := $(DEVICE_PATH)/recovery.fstab
TW_THEME := portrait_hdpi
TW_EXTRA_LANGUAGES := true
TW_DEFAULT_LANGUAGE := ru
TW_INPUT_BLACKLIST := "hbtp_vm"
TW_USE_TOOLBOX := true
TW_INCLUDE_CRYPTO := false
PLATFORM_VERSION := 9.0.0
PLATFORM_SECURITY_PATCH := 2019-10-01
TW_MAX_BRIGHTNESS := 255
TW_DEFAULT_BRIGHTNESS := 120
BOARD_USES_VENDORIMAGE := false
FOX_BEFORE_RECOVERY_IMAGE_HOOK := rm -rf $(TARGET_RECOVERY_ROOT_OUT)/vendor
